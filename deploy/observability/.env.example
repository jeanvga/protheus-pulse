# Copie para .env e defina uma senha longa antes de iniciar a stack.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Por padrão, os ingressos ficam acessíveis apenas no host central.
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_ROOT_URL=http://localhost:3000
GRAFANA_COOKIE_SECURE=false
OTLP_BIND_ADDRESS=127.0.0.1
OTLP_HTTP_PORT=4318
REMOTE_WRITE_BIND_ADDRESS=127.0.0.1
REMOTE_WRITE_PORT=12347

PROMETHEUS_RETENTION=30d
