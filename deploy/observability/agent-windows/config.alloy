// Instale este Alloy no mesmo servidor Windows do Pulse. O receiver OTLP fica
// restrito ao loopback; apenas o remote_write sai do host por HTTPS.
otelcol.receiver.otlp "pulse" {
  http {
    endpoint = "127.0.0.1:4318"
  }

  output {
    metrics = [otelcol.processor.memory_limiter.pulse.input]
  }
}

otelcol.processor.memory_limiter "pulse" {
  check_interval = "1s"
  limit          = "256MiB"
  spike_limit    = "64MiB"

  output {
    metrics = [otelcol.processor.batch.pulse.input]
  }
}

otelcol.processor.batch "pulse" {
  timeout             = "5s"
  send_batch_size     = 1000
  send_batch_max_size = 2000

  output {
    metrics = [otelcol.exporter.prometheus.pulse.input]
  }
}

otelcol.exporter.prometheus "pulse" {
  add_metric_suffixes  = false
  include_scope_labels = false
  forward_to           = [prometheus.remote_write.central.receiver]
}

prometheus.exporter.windows "host" {
  enabled_collectors = [
    "cpu",
    "cs",
    "logical_disk",
    "memory",
    "net",
    "os",
    "process",
    "service",
    "system",
    "tcp",
  ]

  // Evita criar séries para todos os processos do servidor.
  process {
    include = "(?i)^(appserver|broker|dbaccess|license|totvs|webapp).*$"
  }
}

prometheus.scrape "windows" {
  targets         = prometheus.exporter.windows.host.targets
  scrape_interval = "30s"
  scrape_timeout  = "10s"
  forward_to      = [prometheus.remote_write.central.receiver]
}

prometheus.remote_write "central" {
  external_labels = {
    collector = "alloy-windows",
  }

  endpoint {
    url = sys.env("PULSE_REMOTE_WRITE_URL")

    basic_auth {
      username      = sys.env("PULSE_REMOTE_WRITE_USERNAME")
      password_file = sys.env("PULSE_REMOTE_WRITE_PASSWORD_FILE")
    }
  }
}
